SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://pgm-bp13o3671b31vgk2.pg.rds.aliyuncs.com:5432/workbench
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=detail_app_admin
SPRING_DATASOURCE_PASSWORD=<replace-with-production-password>

APP_AI_GATEWAY_MODE=http
# Base64 编码的随机 32 字节主密钥，仅通过部署环境注入，不提交真实值。
APP_AI_MASTER_KEY=<replace-with-base64-encoded-32-byte-key>

# Sub2API v0.2.5 管理接口。Admin API Key 在 Sub2API 管理后台生成，只注入服务端环境。
APP_SUB2API_BASE_URL=http://127.0.0.1:8081
APP_SUB2API_ADMIN_API_KEY=<replace-with-sub2api-admin-api-key>
APP_SUB2API_CONNECT_TIMEOUT_SECONDS=5
APP_SUB2API_REQUEST_TIMEOUT_SECONDS=30

APP_STORAGE_MODE=local
APP_STORAGE_LOCAL_ROOT=/data/ai-toolbench/uploads
# 对外访问 Origin，不包含 /api/files 路径。
APP_STORAGE_PUBLIC_ORIGIN=https://workbench.example.com

APP_OSS_ENDPOINT=
APP_OSS_BUCKET=
APP_OSS_ACCESS_KEY_ID=
APP_OSS_ACCESS_KEY_SECRET=
APP_TOOL_SESSION_SERVICE_CREDENTIAL=
# Employee provisioning is enabled only after configuring a verified relay group.
APP_RELAY_GROUP_ID=0
APP_RELAY_SYNC_DELAY_MS=60000
